  "cannotUnlockOutputs": {
    "message": "Could not unlock audio outputs."
  },
  "applying": {
    "message": "Applying..."
  },
  "activeTabRoutingStatus": {
    "message": "$LABEL$: routing active tab, volume $PERCENT$%.",
