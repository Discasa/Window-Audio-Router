      "label": {
        "content": "$1"
      },
      "percent": {
        "content": "$2"
      }
    }
  },
  "tabCaptureFailedStatus": {
    "message": "$LABEL$: tab capture failed ($ERROR$).",
    "placeholders": {
      "label": {
        "content": "$1"
      },
      "error": {
        "content": "$2"
      }
    }
  },
  "partiallyAppliedStatus": {
    "message": "$LABEL$: partially applied, volume $PERCENT$%.",
    "placeholders": {
      "label": {
        "content": "$1"
      },
      "percent": {
        "content": "$2"
      }
    }
  },
  "volumeStatus": {
    "message": "$LABEL$: volume $PERCENT$%.",
    "placeholders": {
      "label": {
        "content": "$1"
      },
      "percent": {
        "content": "$2"
      }
    }
