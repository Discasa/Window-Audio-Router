      "window_id": {
        "content": "$1"
      }
    }
  },
  "audioControlsLabel": {
    "message": "Audio output controls"
  },
  "outputDeviceLabel": {
    "message": "Output device"
  },
  "windowsDefaultOption": {
    "message": "Windows default"
  },
  "volumeLabel": {
    "message": "Volume"
  },
  "unnamedAudioOutput": {
    "message": "Audio output $INDEX$",
    "placeholders": {
      "index": {
        "content": "$1"
      }
    }
  },
  "previouslySelectedOutput": {
    "message": "Previously selected output"
  },
  "detectingOutputs": {
    "message": "Detecting outputs..."
  },
  "noRealOutputs": {
    "message": "No real output detected."
