{
  "extensionDescription": {
    "message": "Route per-window audio in Edge/Chromium with setSinkId and tabCapture/offscreen playback."
  },
  "popupTitle": {
    "message": "Audio output for this window"
  },
  "windowLabel": {
    "message": "Window $WINDOW_ID$",
